{
  "name": "@cosave/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:postal-codes": "tsx --env-file-if-exists=.env scripts/import-postal-codes.ts",
    "db:make-admin": "tsx --env-file-if-exists=.env scripts/make-admin.ts",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@cosave/shared": "workspace:*",
    "@prisma/client": "^6",
    "@supabase/supabase-js": "^2",
    "cors": "^2",
    "express": "^5",
    "helmet": "^8",
    "jose": "^6",
    "sharp": "^0.35.5",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/node": "^20",
    "esbuild": "^0.25",
    "prisma": "^6",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
