# ---- apps/api (copiar a apps/api/.env) ----
PORT=3300
WEB_URL=http://localhost:5300
# Supabase → Project Settings → Database → Connection string
# DATABASE_URL: pooler (Transaction, puerto 6543) para la app
DATABASE_URL=
# DIRECT_URL: conexión directa (puerto 5432), la usa Prisma para migrar
DIRECT_URL=
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Solo servidor (Project Settings → API → service_role). Sube las fotos al bucket público "property-images".
SUPABASE_SERVICE_ROLE_KEY=
# true: las publicaciones esperan aprobación de un admin; false: se publican directo
PUBLISH_REQUIRES_APPROVAL=true

# ---- apps/web (copiar a apps/web/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:3300
NEXT_PUBLIC_SUPABASE_URL=
# Clave "anon / publishable" (pública por diseño; nunca uses la service_role aquí)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
